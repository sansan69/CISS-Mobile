<?xml version="1.0" encoding="utf-8"?>
<!--
  F-17 / P-08: `android:allowBackup="false"` only disables Google Drive backup.
  On Android 12+ it does NOT stop device-to-device (D2D) transfer, so app data
  (unencrypted Hive drafts, read caches, queue contents, shared_prefs) could
  still be copied to a replacement device.

  These rules exclude every backup domain from both cloud backup and device
  transfer. `path="."` targets the domain root, which the backup framework
  applies recursively to all files and subdirectories.

  `android:fullBackupContent="false"` in the manifest keeps API <= 30 covered;
  this file covers API 31+.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
